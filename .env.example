# Optional: environment overrides for VPS / Docker deployments.
# On cPanel you don't need this file. The installer writes config/config.php.
# Set these as real environment variables (Docker env_file, PHP-FPM env[...], Apache SetEnv).
# NextaCRM does not parse .env files itself. Values override config/config.php. Never commit real secrets.
NEXTACRM_APP_KEY=        # base64 of 32 random bytes: php -r "echo base64_encode(random_bytes(32));"
NEXTACRM_URL=https://crm.example.com
NEXTACRM_DB_HOST=localhost
NEXTACRM_DB_PORT=3306
NEXTACRM_DB_NAME=example_crm
NEXTACRM_DB_USER=example_user
NEXTACRM_DB_PASSWORD=
NEXTACRM_TRUSTED_PROXIES=  # comma-separated proxy IPs
