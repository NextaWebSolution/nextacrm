      "Database connection test",
      "Application URL",
      "Administrator account",
      "Company configuration",
      "Initial database migration",
      "Default module installation",
      "Completion"
    ],
    "lock_file": "storage/installed.lock",
    "config_file": "config/config.php"
  },
  "update": {
