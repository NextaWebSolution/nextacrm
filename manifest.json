{
  "name": "NextaCRM",
  "slug": "nextacrm",
  "version": "2.0.2",
  "release_date": "2026-11-17",
  "channel": "stable",
  "description": "All-in-one IT business management CRM: leads, deals, quotations, invoices, projects, tasks, time tracking, support tickets with SLA, HR, calendar, files, automation and REST API. Runs on standard cPanel hosting.",
  "vendor": {
    "name": "Nexta Web Solution Pvt. Ltd.",
    "url": "https://nextawebsolution.com",
    "support": "hr@nextawebsolution.com"
  },
  "license": "Proprietary",
  "requirements": {
    "php": "8.2.0",
    "php_recommended": "8.3.0",
    "database": {
      "mysql": "8.0",
      "mariadb": "10.6"
    },
    "web_server": [
      "Apache 2.4 with mod_rewrite",
      "LiteSpeed",
      "Nginx (see docs/INSTALL.md)"
    ],
    "extensions": [
      "pdo",
      "pdo_mysql",
      "mbstring",
      "json",
      "openssl",
      "curl",
      "fileinfo",
      "zip",
      "sodium",
      "dom",
      "ctype",
      "filter",
      "hash",
      "session"
    ],
    "optional_extensions": {
      "gd": "image checks and PDF images",
      "intl": "better locale formatting",
      "ftp": "FTP storage driver",
      "opcache": "performance"
    },
    "writable": [
      "config",
      "storage",
      "storage/uploads",
      "storage/logs",
      "storage/cache",
      "storage/tmp",
      "storage/backups",
      "storage/sessions"
    ],
    "not_required": [
      "root SSH",
      "Docker",
      "Node.js",
      "Redis",
      "Supervisor",
      "Composer"
    ]
  },
